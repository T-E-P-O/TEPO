# Base dati
DB_URL=jdbc:postgresql://localhost:5432/tepo
DB_USERNAME=tepo
DB_PASSWORD=tepo

# Applicazione
SERVER_PORT=8080
FRONTEND_PORT=5173

# Solver â€” timeout per fase (secondi)
TEPO_SOLVER_PRIMARY_TIMEOUT=10
TEPO_SOLVER_SECONDARY_TIMEOUT=3
TEPO_SOLVER_LEX_TIMEOUT=1

# AI â€” provider LLM opzionale
# Nessuna chiave Ã¨ necessaria: l'app funziona con il motore locale deterministico.
TEPO_AI_ENABLED=false
LLM_API_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
TEPO_AI_TIMEOUT=20
TEPO_AI_MAX_TOKENS=512
TEPO_AI_FALLBACK=true
TEPO_AI_MAX_INPUT=2000
TEPO_AI_TEMPERATURE=0.2
